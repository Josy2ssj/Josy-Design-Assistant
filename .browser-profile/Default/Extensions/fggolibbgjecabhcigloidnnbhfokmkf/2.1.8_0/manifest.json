{
   "action": {
      "default_icon": {
         "128": "images/icon128.png",
         "16": "images/icon16.png",
         "32": "images/icon32.png",
         "48": "images/icon48.png"
      },
      "default_title": "Whisk Automator - Bulk AI Image Generation Toolkit for Whisk AI"
   },
   "background": {
      "service_worker": "background.js",
      "type": "module"
   },
   "content_scripts": [ {
      "js": [ "content-scripts/flow.js" ],
      "matches": [ "https://flow.google.com/*" ],
      "run_at": "document_start",
      "world": "ISOLATED"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "description": "Whisk AI bulk image generator for Google Flow. Automate Whisk prompts, batch generate & auto download. Nano Banana 2 & Pro.",
   "host_permissions": [ "https://flow.google.com/*", "https://aisandbox-pa.googleapis.com/*", "https://gemini.google.com/*", "https://chatgpt.com/*" ],
   "icons": {
      "128": "images/icon128.png",
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Whisk Automator - Bulk AI Image Generation with Nano Banana 2 & Pro",
   "permissions": [ "activeTab", "storage", "sidePanel", "identity", "tabs", "downloads", "scripting", "offscreen" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.1.8",
   "web_accessible_resources": [ {
      "matches": [ "https://flow.google.com/*" ],
      "resources": [ "images/*", "flowInterceptor.js" ]
   } ]
}
